# ==============================================================================
# Shotlab - Environment Variables Configuration
# ==============================================================================

# ComfyUI server base URL (HTTP and WebSocket)
COMFYUI_URL=http://localhost:8188

# SQLite database file path (relative to backend/ or absolute path)
DATABASE_PATH=shotlab.db

# Allowed CORS origins for FastAPI (comma-separated or JSON array)
# Security notice: Wildcard '*' is disallowed when allow_credentials=True.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Optional: Path to MOSS-Image model checkpoint directory
# MOSS_MODEL_PATH=/home/rukashi/Documentos/ComfyUI_windows_portable/ComfyUI/models/moss-image-sft
